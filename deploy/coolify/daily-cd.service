[Unit]
Description=Deploy the tested Daily image through Coolify
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/daily/data /srv/daily/backups

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/daily-cd/coolify_cd.py
TimeoutStartSec=90min
# Keep interrupted maintenance latched for manual inspection after reboot/failure.
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/daily-cd
# Docker access is root-equivalent; these sandbox options do not change that.
