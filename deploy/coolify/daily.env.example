# Import these values into Coolify and set every empty value before enabling production traffic.
# This file contains no production secrets.
NODE_ENV=production
HOST=0.0.0.0
PORT=5174
ORIGIN=https://dailykickoff.eu
BETTER_AUTH_URL=https://dailykickoff.eu

# Server AI Observability and Logs. Match the project used to build the browser bundle.
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

DATABASE_URL=/var/lib/daily/daily.db
BACKUP_DIRECTORY=/var/backups/daily
MIGRATIONS_DIRECTORY=/app/drizzle
BACKUP_RETENTION_DAYS=30

# Set to false for the first deployment and during every migration or restore.
SCHEDULED_DELIVERY_ENABLED=false
SCHEDULED_WORKER_OVERDUE_MINUTES=5

# Web and Google login.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps. API keys are optional until the related feature is enabled.
GOOGLE_MAPS_KILL_SWITCH=false
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_GLOBAL_DAILY_CAP=100
GOOGLE_ROUTES_GLOBAL_MONTHLY_CAP=1000
GOOGLE_ROUTES_PER_PERSON_DAILY_LIMIT=50
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_GLOBAL_MONTHLY_CAP=10000
GOOGLE_PLACES_PER_PERSON_DAILY_LIMIT=500
GOOGLE_MAPS_ATTRIBUTION_SECRET=
GOOGLE_MAPS_OPERATOR_ALERT_EMAIL=

# Comma-separated verified Google emails allowed to access /admin.
ADMINISTRATOR_EMAIL_ALLOWLIST=
OPERATIONAL_RETENTION_DAYS=30

# Scheduled Delivery. Keep these set only when Scheduled Delivery is enabled.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPENAI_API_KEY=
# Optional weather LLM settings. Character limit includes spaces and punctuation.
OPENAI_WEATHER_MODEL=gpt-5.6-luna
OPENAI_WEATHER_REASONING_EFFORT=none
OPENAI_WEATHER_MAX_CHARACTERS=160
# Developer prompt. {{maxCharacters}} includes the shorter retry target; blank uses this default.
OPENAI_WEATHER_PROMPT="Write exactly one factual English weather sentence on one line. Use only the normalized weather values supplied by the user. Use at most {{maxCharacters}} characters, including spaces and punctuation. Prioritize unusual or actionable conditions and their local time of day. Do not mention a location, identity, greeting, recommendation, action, or unsupported fact. End the sentence with one period."
# Leave blank for automatic token and timeout budgets based on reasoning effort.
OPENAI_WEATHER_MAX_OUTPUT_TOKENS=
OPENAI_WEATHER_TIMEOUT_MS=
